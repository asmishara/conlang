# Copy to .env and fill in.

# Postgres connection string. `docker compose up -d` starts one matching this URL.
DATABASE_URL="postgresql://conlang:conlang@localhost:5432/conlang"

# Random secret for signing sessions. Generate with: npx auth secret
AUTH_SECRET=""

# Sign-in providers: fill in at least one. Unset providers are hidden.
# GitHub: https://github.com/settings/developers  (callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google: https://console.cloud.google.com/apis/credentials  (callback: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

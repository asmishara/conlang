// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (https://authjs.dev/getting-started/adapters/prisma) ----------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  languages     Language[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Conlang data ----------

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Language {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  autonym     String?
  description String?
  visibility  Visibility @default(PRIVATE)
  phonemes    Phoneme[]
  words       Word[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

enum PhonemeKind {
  CONSONANT
  VOWEL
}

/// One sound in a language's inventory, with how it is spelled.
model Phoneme {
  id         String      @id @default(cuid())
  languageId String
  language   Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  ipa        String
  kind       PhonemeKind
  spelling   String
  /// Order within the inventory; also the default alphabet order.
  position   Int

  @@unique([languageId, ipa])
  @@index([languageId, position])
}

/// A dictionary entry.
model Word {
  id            String   @id @default(cuid())
  languageId    String
  language      Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  /// The word as written in the language's spelling.
  form          String
  /// IPA override. When null, the pronunciation is derived from the spelling.
  pronunciation String?
  partOfSpeech  String?
  /// Short meaning, e.g. "water" or "to run".
  gloss         String
  etymology     String?
  notes         String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([languageId])
}

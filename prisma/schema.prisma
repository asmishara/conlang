// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (https://authjs.dev/getting-started/adapters/prisma) ----------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  languages     Language[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Conlang data ----------

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Language {
  id           String           @id @default(cuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  autonym      String?
  description  String?
  visibility   Visibility       @default(PRIVATE)
  phonemes     Phoneme[]
  words        Word[]
  generator    WordGenerator?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  grammarPages GrammarPage[]
  paradigms    Paradigm[]
  soundChanges SoundChangeSet[]

  @@index([ownerId])
}

enum PhonemeKind {
  CONSONANT
  VOWEL
}

/// One sound in a language's inventory, with how it is spelled.
model Phoneme {
  id         String      @id @default(cuid())
  languageId String
  language   Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  ipa        String
  kind       PhonemeKind
  spelling   String
  /// Order within the inventory; also the default alphabet order.
  position   Int

  @@unique([languageId, ipa])
  @@index([languageId, position])
}

/// A dictionary entry.
model Word {
  id             String          @id @default(cuid())
  languageId     String
  language       Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  /// The word as written in the language's spelling.
  form           String
  /// IPA override. When null, the pronunciation is derived from the spelling.
  pronunciation  String?
  partOfSpeech   String?
  /// Short meaning, e.g. "water" or "to run".
  gloss          String
  etymology      String?
  notes          String?
  tags           String[]
  irregularForms IrregularForm[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([languageId])
}

/// Saved word generator settings for a language.
model WordGenerator {
  languageId   String   @id
  language     Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  /// [{ label: "C", members: ["p", "t"] }, ...]
  categories   Json
  patterns     String[]
  minSyllables Int
  maxSyllables Int
  dropoff      Boolean
  forbidden    String[]
  updatedAt    DateTime @updatedAt
}

/// A page of grammar documentation. Pages nest under a parent page.
model GrammarPage {
  id         String        @id @default(cuid())
  languageId String
  language   Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     GrammarPage?  @relation("GrammarTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   GrammarPage[] @relation("GrammarTree")
  title      String
  /// Markdown, with ```gloss blocks for interlinear examples.
  body       String        @default("")
  position   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([languageId, parentId, position])
}

/// An inflection table for one part of speech, e.g. noun case × number.
model Paradigm {
  id             String          @id @default(cuid())
  languageId     String
  language       Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  name           String
  /// Words with this part of speech get these forms.
  partOfSpeech   String
  /// [{ name: "Case", values: ["nominative", "accusative"] }, ...], at most three.
  dimensions     Json
  /// The rule for each cell, keyed by the JSON array of its values in dimension order.
  rules          Json            @default("{}")
  irregularForms IrregularForm[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([languageId, partOfSpeech])
}

/// One word's own form for a cell of a table, used instead of the cell's rule.
model IrregularForm {
  id         String   @id @default(cuid())
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  paradigmId String
  paradigm   Paradigm @relation(fields: [paradigmId], references: [id], onDelete: Cascade)
  /// The cell, keyed like Paradigm.rules.
  cell       String
  /// The form, or "" when this word has no form for the cell.
  form       String

  @@unique([wordId, paradigmId, cell])
  @@index([paradigmId])
}

/// An ordered list of sound changes to run the language's words through,
/// e.g. the changes from this language to one of its descendants.
model SoundChangeSet {
  id         String   @id @default(cuid())
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  name       String
  /// One rule or class per line, like "p t k > b d g / V_V".
  rules      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([languageId])
}
